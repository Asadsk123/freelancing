# ===========================================
# Royal Asad - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Neon PostgreSQL) ---
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech/royal-asad?sslmode=require

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-secret-key-at-least-32-characters-long

# --- Auth Timing ---
OTP_EXPIRY_MINUTES=10
SESSION_DURATION_DAYS=30

# --- Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=royal-asad
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# --- Email (Resend) ---
# EMAIL_MODE controls delivery:
#   (unset)      -> real send only when NODE_ENV=production AND RESEND_API_KEY set; otherwise log-only
#   production   -> force real sending (requires RESEND_API_KEY) — use with care
#   log/preview  -> never send; log a sanitized line (safe for development)
# Development NEVER sends real email unless EMAIL_MODE=production is set explicitly.
EMAIL_MODE=log
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM_DEFAULT=hello@royalasad.com
EMAIL_FROM_SUPPORT=support@royalasad.com
# Deliverability (configure DNS for your sending domain before going live):
#   SPF   TXT   "v=spf1 include:_spf.resend.com ~all"
#   DKIM  CNAME records provided in the Resend dashboard for your domain
#   DMARC TXT   "v=DMARC1; p=quarantine; rua=mailto:dmarc@royalasad.com"

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
